{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spherex-viewer/schemas/manifest.schema.json",
  "title": "Índice de alvos pré-processados (data/manifest.json)",
  "description": "Lista os campos publicados como dados estáticos. Ver docs/04-api.md §6.",
  "type": "object",
  "required": ["schema_version", "generated_at", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "ra", "dec", "fov_arcmin", "default_detector", "field",
                     "latest_exposure_mjd", "thumbnail"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "ra": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
          "dec": { "type": "number", "minimum": -90, "maximum": 90 },
          "fov_arcmin": { "type": "number", "exclusiveMinimum": 0 },
          "default_detector": { "enum": ["D1", "D2", "D3", "D4", "D5", "D6"] },
          "field": { "type": "string", "pattern": "^fields/.+/field\\.json$" },
          "latest_exposure_mjd": { "type": "number" },
          "thumbnail": { "type": "string", "pattern": "\\.png$" }
        }
      }
    }
  }
}
