        <mxCell id="n26" value="deploy-pages&#xa;&lt;user&gt;.github.io/spherex-viewer&#xa;abre na hora, sem backend" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbf9f4;strokeColor=#c4302b;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#141414;verticalAlign=middle;align=center;spacing=6;convertToSvg=1;" vertex="1" parent="lane8"><mxGeometry x="2910" y="76" width="190" height="84" as="geometry" /></mxCell>
        <mxCell id="note10" value="Nada nesta página existe ainda: o update-data.yml entra na fase 5.&#xa;A execução fica registrada e auditável na aba Actions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;strokeColor=none;fillColor=none;convertToSvg=1;" vertex="1" parent="lane2"><mxGeometry x="510" y="68" width="620" height="54" as="geometry" /></mxCell>
        <mxCell id="note19" value="actions/cache guarda os recortes entre execuções.&#xa;O GitHub apaga cache sem uso há 7 dias — daí o cron de 3 em 3 dias." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;strokeColor=none;fillColor=none;convertToSvg=1;" vertex="1" parent="lane5"><mxGeometry x="30" y="82" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="note21" value="Primeira execução: ~1.950 recortes, ~60 min.&#xa;Com o cache cheio: consulta + exposições novas, 1–3 min." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;strokeColor=none;fillColor=none;convertToSvg=1;" vertex="1" parent="lane6"><mxGeometry x="30" y="72" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="note25" value="A validação não é um relatório: se ela falha, o deploy não acontece.&#xa;Tolerâncias medidas com os 5 alvos reais (docs/06-testes.md)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;strokeColor=none;fillColor=none;convertToSvg=1;" vertex="1" parent="lane7"><mxGeometry x="30" y="82" width="620" height="60" as="geometry" /></mxCell>
