<mxCell id="sl3" value="Cache / arquivo em disco" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3d3a34;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="106" y="266" width="330" height="24" as="geometry" /></mxCell>
<mxCell id="sw4" value="" style="rounded=1;arcSize=8;html=1;fillColor=#f2efe7;strokeColor=#5e584c;strokeWidth=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="52" height="24" as="geometry" /></mxCell>
<mxCell id="sl4" value="Serviço externo (IRSA)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3d3a34;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="106" y="308" width="330" height="24" as="geometry" /></mxCell>
<mxCell id="sw5" value="" style="rounded=1;arcSize=8;html=1;fillColor=#fbf9f4;strokeColor=#c4302b;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="52" height="24" as="geometry" /></mxCell>
<mxCell id="sl5" value="Resultado para o visitante" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3d3a34;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="106" y="350" width="330" height="24" as="geometry" /></mxCell>
<mxCell id="sw6" value="" style="rounded=1;arcSize=8;html=1;fillColor=#fbf9f4;strokeColor=#3d3a34;strokeWidth=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="52" height="24" as="geometry" /></mxCell>
<mxCell id="sl6" value="Fase 5 — planejado (não existe ainda)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3d3a34;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="106" y="392" width="330" height="24" as="geometry" /></mxCell>
<mxCell id="h140" value="Números medidos no pipeline real" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#141414;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="140" width="560" height="24" as="geometry" /></mxCell>
<mxCell id="b170" value="· 258 exposições do WISE 0855 entre mai/2025 e mai/2026, em 4 épocas." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="170" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b204" value="· Cada recorte: ~4 MB e ~6 s; ~95% do peso é a extensão PSF, descartada." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="204" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b238" value="· Cache de exposições: ~60 KB por recorte (~370 MB para 1.950)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="238" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b272" value="· Primeira execução do Action: ~60 min. Com cache cheio: 1–3 min." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="272" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b306" value="· Quadro entregue ao navegador: 60×60 float32 ≈ 14 KB." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="306" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b340" value="· Pixel do SPHEREx: 6,15″. Barnard&#x27;s Star anda ~1,5–2 px por semestre." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="340" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b374" value="· Recorte 1,5 × o campo: cobre a diagonal (√2 ≈ 1,41) sem perder a borda." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="374" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b408" value="· Flags em 2 níveis: 5 bits sempre fora; 4 bits só se não houver pixel limpo." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="408" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="h462" value="Regras que o desenho respeita" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#141414;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="462" width="560" height="24" as="geometry" /></mxCell>
<mxCell id="b492" value="· Um único formato de dados para os dois caminhos (API e Pages)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="492" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b526" value="· O pesado fica no servidor; contraste, blink e diferença ficam no navegador." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="526" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b560" value="· Validação científica bloqueia a publicação — não é só um relatório." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="560" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b594" value="· Erro transitório do IRSA é esquecido: o próximo pedido tenta de novo." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="594" width="560" height="34" as="geometry" /></mxCell>
<mxCell id="b628" value="· Fonte: docs/03-arquitetura.md, 04-api.md, 05-hospedagem.md e o código." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5e584c;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="490" y="628" width="560" height="34" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
