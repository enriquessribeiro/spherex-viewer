<mxCell id="sl2" value="Pipeline científico (Python)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3d3a34;convertToSvg=1;" vertex="1" parent="1"><mxGeometry x="106" y="224" width="330" height="24" as="geometry" /></mxCell>
